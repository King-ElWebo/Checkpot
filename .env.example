# Required for Neon PostgreSQL database access and migrations.
# Use the pooled Neon connection string in production.
DATABASE_URL=

# Central site URL for canonicals, sitemap, OpenGraph, and structured JSON-LD data.
# Production uses: https://checkpot-hietzing.at
# Preview/staging environments can override this value (e.g., https://staging.checkpot-hietzing.at).
SITE_URL=https://checkpot-hietzing.at

# Required for admin session JWT signing (HS256). Must be at least 32 characters:
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Single-admin bootstrap password. Use a strong unique passphrase.
ADMIN_PASSWORD=

# Required for Vercel Blob storage (media uploads/deletions).
BLOB_READ_WRITE_TOKEN=

# Required for contact form email delivery via Resend.
# Obtain API key from https://resend.com
RESEND_API_KEY=

# Optional separate secret for pseudonymous HMAC rate-limit subject hashing.
# If omitted, AUTH_SECRET is used as fallback.
RATE_LIMIT_SECRET=


