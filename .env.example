# Required only when database access or migrations begin.
# Use the pooled Neon connection string for the intended customer project.
DATABASE_URL=

# Required for production canonicals, sitemap URLs, and social metadata.
# Example: https://www.example.com
SITE_URL=

# Required for login. Generate a unique value for every copied project:
# openssl rand -base64 32
AUTH_SECRET=

# Single-admin bootstrap credential. Use a long unique value and a deployment
# secret manager. Replace the baseline auth when the project needs real users.
ADMIN_PASSWORD=
